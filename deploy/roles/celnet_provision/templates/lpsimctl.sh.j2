#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# lpsimctl — start/once/stop/status/tail for the celnet LP-SIM Treasury feed.
# MANAGED BY ANSIBLE. Installed at {{ celnet_bin_dir }}/lpsimctl.
#
#   lpsimctl start | once | stop | status | tail [n]
#
# Thin wrapper over {{ celnet_bin_dir }}/start-lp-sim.sh: it points the launcher at
# the release-shipped lp-sim binary (no cargo needed on the host), daemonizes, and
# logs into the shared log dir. lpsimctl start runs the 5-LP, BOOK-AWARE daemon
# against the LOCAL server ingest (LPSIM_ADDR): it logs in as the service user, polls
# the enabled aggregated books every LPSIM_BOOK_POLL secs, and streams LP-SIM-01..05
# two-ways for exactly the bonds each book scopes — auto-starting/stopping as books
# change. Override the members / book-poll / login / instruments with celnet_lpsim_*.
# Set celnet_lpsim_no_book_poll=1 for the broadcast fallback (whole universe, no poll).
# ---------------------------------------------------------------------------
set -euo pipefail

LAUNCHER="{{ celnet_bin_dir }}/start-lp-sim.sh"
export LPSIM_RELEASE_BIN="{{ celnet_current_link }}/bin/lp-sim"
export LPSIM_RUN_DIR="{{ celnet_run_dir }}/lpsim"
export LPSIM_LOG="{{ celnet_log_dir }}/lp-sim.out.log"
export LPSIM_LP_NAME="{{ celnet_lpsim_lp_name | default('OTC-SIM') }}"
export LPSIM_BOOK="{{ celnet_lpsim_book | default('ust-composite') }}"
export LPSIM_MEMBERS="{{ celnet_lpsim_members | default('4') }}"
# The FIX ORDER acceptors: counterparty i binds LPSIM_ORDER_PORT + i (5701..5704 by
# default). A panel that quotes but will not trade is a price display, not a venue.
export LPSIM_ORDER_PORT="{{ celnet_lpsim_order_port | default('5701') }}"
export LPSIM_ORDER_BIND="{{ celnet_lpsim_order_bind | default('0.0.0.0') }}"
export LPSIM_INTERVAL="{{ celnet_lpsim_interval | default('2') }}"
# Sub-second override (ms): non-empty ⇒ the feed refreshes the composite faster than 1s.
export LPSIM_INTERVAL_MS="{{ celnet_lpsim_interval_ms | default('') }}"
export LPSIM_BOOK_POLL="{{ celnet_lpsim_book_poll | default('5') }}"
export LPSIM_NO_BOOK_POLL="{{ celnet_lpsim_no_book_poll | default('0') }}"
export LPSIM_INSTRUMENTS="{{ celnet_lpsim_instruments | default('all') }}"
export LPSIM_MAX_INSTRUMENTS="{{ celnet_lpsim_max_instruments | default('12') }}"
export LPSIM_SEED="{{ celnet_lpsim_seed | default('305419896') }}"
export LPSIM_SETTLEMENT="{{ celnet_lpsim_settlement | default('2026-04-16') }}"
export LPSIM_INCLUDE_BILLS="{{ celnet_lpsim_include_bills | default('0') }}"
export LPSIM_NO_FAULTS="{{ celnet_lpsim_no_faults | default('0') }}"
# Service login for the book poll (AuthService.Login); defaults to the seeded admin.
export LPSIM_USER="{{ celnet_lpsim_user | default('lp-sim@svc.celnet.local') }}"
{% if celnet_lpsim_password is defined and celnet_lpsim_password %}
# NOTE: an inline password in group_vars is DISCOURAGED — prefer the password file below,
# which keeps the secret off disk in git and out of this generated script.
export LPSIM_PASSWORD="{{ celnet_lpsim_password }}"
{% endif %}
# A host-local password file (mode 600, NOT in git) overrides LPSIM_PASSWORD when present
# — put the real service credential here on the box so no secret lives in group_vars:
#   printf '%s' 'THE_PASSWORD' > {{ celnet_lpsim_password_file | default('/home/' ~ (celnet_user | default('celnet')) ~ '/.lpsim_pw') }} && chmod 600 "$_"
export LPSIM_PASSWORD_FILE="{{ celnet_lpsim_password_file | default('/home/' ~ (celnet_user | default('celnet')) ~ '/.lpsim_pw') }}"
# The secret is handed to the daemon through THIS environment only. lp-sim has no
# --password flag: argv is world-readable, so a flag would publish it to every local
# account via `ps`. Verify with:  ps -ww -o args= -C lp-sim | grep -c password  → 0
# Network feed endpoint: lp-sim streams LpQuotes to the server's LpFeed ingest so the
# composite surfaces to GUI subscribers (default: the local gRPC edge). Book-aware
# mode requires this to be set (it is, by default).
export LPSIM_ADDR="{{ celnet_lpsim_addr | default('http://127.0.0.1:' ~ (celnet_grpc_port | default('50051'))) }}"

PIDFILE="$LPSIM_RUN_DIR/lp-sim.pid"

is_running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then echo "lp-sim already running (pid $(cat "$PIDFILE"))"; exit 0; fi
    [[ -x "$LPSIM_RELEASE_BIN" ]] || { echo "ERROR: $LPSIM_RELEASE_BIN missing (deploy a release with celnet_lpsim_enabled)"; exit 1; }
    LPSIM_DAEMON=1 "$LAUNCHER"
    ;;
  once)
    LPSIM_ONESHOT=1 "$LAUNCHER"
    ;;
  restart)
    # Managed-service restart: stop any running daemon, then start a fresh one. Used by
    # the deploy (deploy.yml post_tasks) so every release re-launches the feed.
    "$0" stop || true
    sleep 1
    "$0" start
    ;;
  stop)
    if is_running; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; echo "Stopped."; else echo "lp-sim not running"; rm -f "$PIDFILE"; fi
    ;;
  status)
    if is_running; then
      echo "lp-sim: RUNNING (pid $(cat "$PIDFILE"))"
      echo "  log: $LPSIM_LOG"
      if [ "$LPSIM_NO_BOOK_POLL" = "1" ]; then
        echo "  mode: broadcast ($LPSIM_MEMBERS LPs, ${LPSIM_INTERVAL}s, whole universe → $LPSIM_ADDR)"
      else
        echo "  mode: book-aware ($LPSIM_MEMBERS named counterparties → $LPSIM_ADDR, book-poll ${LPSIM_BOOK_POLL}s, login $LPSIM_USER)"
        echo "  orders: ${LPSIM_ORDER_PORT:-DISABLED (price display only)}"
        echo "  members: marketaccess-sim traderweb-sim citigroup-sim jpm-sim"
      fi
    else echo "lp-sim: STOPPED"; exit 3; fi
    ;;
  tail)
    tail -n "${2:-50}" -f "$LPSIM_LOG"
    ;;
  *)
    echo "usage: lpsimctl {start|once|restart|stop|status|tail [n]}"; exit 64
    ;;
esac
