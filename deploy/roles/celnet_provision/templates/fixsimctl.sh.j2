#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fixsimctl — start/stop/status/tail for the celnet FIX quote simulator.
# MANAGED BY ANSIBLE. Installed at {{ celnet_bin_dir }}/fixsimctl.
#
#   fixsimctl start | once | stop | status | tail [n]
#
# Thin wrapper over {{ celnet_bin_dir }}/start-fix-sim.sh: it points the launcher
# at the release-shipped RFQ client binary (no cargo needed on the host) and the
# managed FIX acceptor, daemonizes, and logs into the shared log dir. The acceptor
# address/CompIDs default to the runtime registry's "CELNET_FXO_VENUE" venue; override
# with celnet_fixsim_* group_vars if the GUI FIX admin changes them.
# ---------------------------------------------------------------------------
set -euo pipefail

LAUNCHER="{{ celnet_bin_dir }}/start-fix-sim.sh"
export FIXSIM_RFQ_BIN="{{ celnet_current_link }}/bin/fix-rfq-client"
export FIXSIM_RUN_DIR="{{ celnet_run_dir }}/fixsim"
export FIXSIM_LOG="{{ celnet_log_dir }}/fix-sim.out.log"
export FIXSIM_HOST="{{ celnet_fixsim_host | default('127.0.0.1') }}"
# Asset class (fi = fixed income / OIS, the default; fx = FX options). The launcher
# derives the per-asset acceptor port + CompIDs unless overridden below.
export FIXSIM_ASSET="{{ celnet_fixsim_asset | default('fi') }}"
export FIXSIM_CURVE="{{ celnet_fixsim_curve | default('USD-OIS') }}"
export FIXSIM_TENOR="{{ celnet_fixsim_tenor | default('5') }}"
# Intent MUST match the acceptor kind of the venue THIS leg targets (FIXSIM_PORT). The
# server gates the dialect on the venue's own kind (`subscription_matches_intent` in
# services/fix.rs): a fixed_income_QUOTE venue answers ONLY a Snapshot (rfq); Subscribe
# (rfs) is answered ONLY by a fixed_income_stream / _esp venue. A mismatch is dropped
# with NO reject and NO log line — the leg looks healthy and streams nothing
# ("streamed 0 update(s)"), which is exactly how this leg silently died on UAT.
# This leg targets the QUOTE venue, so it is "rfq"; the streaming flows have their own
# legs (FIXSIM_STREAM_PORT / FIXSIM_ESP_PORT) against the stream venue.
export FIXSIM_INTENT="{{ celnet_fixsim_intent | default('rfq') }}"
# Notional "mix" ⇒ a stream rotates a 100k…30m clip ladder per request (varied booked
# sizes + DV01); a number pins it. Side "mix" ⇒ a stream rotates pay/receive per request
# (BUY/SELL booked-deal mix); pay|receive|two-way pins it. Both are overridable.
export FIXSIM_NOTIONAL="{{ celnet_fixsim_notional | default('mix') }}"
export FIXSIM_SIDE="{{ celnet_fixsim_side | default('mix') }}"
{% if celnet_fixsim_port is defined %}export FIXSIM_PORT="{{ celnet_fixsim_port }}"
{% endif %}{% if celnet_fixsim_sender is defined %}export FIXSIM_SENDER="{{ celnet_fixsim_sender }}"
{% endif %}{% if celnet_fixsim_target is defined %}export FIXSIM_TARGET="{{ celnet_fixsim_target }}"
{% endif %}export FIXSIM_PERIOD="{{ celnet_fixsim_period | default('20') }}"
export FIXSIM_JITTER="{{ celnet_fixsim_jitter | default('60') }}"
# FAST sub-second cadence (ms): OVERRIDES FIXSIM_PERIOD via the client's --interval-ms so a
# redeploy builds up deals/positions/flow/risk quickly. Default 750ms; set "" to fall back.
export FIXSIM_PERIOD_MS="{{ celnet_fixsim_period_ms | default('750') }}"
export FIXSIM_STREAM_HOLD_MS="{{ celnet_fixsim_stream_hold_ms | default('2000') }}"
# Every Nth auto-quote is LIFTED (executed → booked deal); the rest stay quoted-only.
export FIXSIM_LIFT_EVERY="{{ celnet_fixsim_lift_every | default('3') }}"
{% if celnet_fixsim_stream_port is defined and celnet_fixsim_stream_port %}
# RFS (streaming) leg: a second client subscribes to this fixed-income STREAM acceptor.
export FIXSIM_STREAM_PORT="{{ celnet_fixsim_stream_port }}"
export FIXSIM_STREAM_SENDER="{{ celnet_fixsim_stream_sender | default('CELNET_RATES_STREAM') }}"
export FIXSIM_STREAM_HOLD="{{ celnet_fixsim_stream_hold | default('15') }}"
{% endif %}
# ESP (streaming) leg: when enabled AND a fixed-income STREAM acceptor is reachable, a
# supervised `--asset esp` client downloads the top-N reference-data instruments over gRPC
# and streams bond RFS on them (composite-priced + pricing-group-tiered), randomly lifting
# some to book live streaming deals.
export FIXSIM_ESP="{{ '1' if celnet_fixsim_esp_enabled | default(false) else '0' }}"
{% if celnet_fixsim_esp_port is defined and celnet_fixsim_esp_port %}export FIXSIM_ESP_PORT="{{ celnet_fixsim_esp_port }}"
{% elif celnet_fixsim_stream_port is defined and celnet_fixsim_stream_port %}export FIXSIM_ESP_PORT="{{ celnet_fixsim_stream_port }}"
{% endif %}export FIXSIM_ESP_SENDER="{{ celnet_fixsim_esp_sender | default('CELNET_RATES_STREAM') }}"
export FIXSIM_GRPC_ADDR="{{ celnet_fixsim_grpc_addr | default('http://127.0.0.1:50051') }}"
export FIXSIM_ESP_INSTRUMENTS="{{ celnet_fixsim_esp_instruments | default('15') }}"
# Every Nth RFQ is a MANUAL curve request routed to the human rates desk. 1 ⇒ all of them:
# the RFQ venue is the manual-pricing leg, and auto-quoted OIS on it drowns the blotter.
export FIXSIM_MANUAL_EVERY="{{ celnet_fixsim_manual_every | default('3') }}"
export FIXSIM_ESP_SEED="{{ celnet_fixsim_esp_seed | default('0x5EED1234') }}"
export FIXSIM_USER="{{ celnet_fixsim_user | default('fix-sim@svc.celnet.local') }}"
{% if celnet_fixsim_password is defined and celnet_fixsim_password %}
# NOTE: an inline password in group_vars is DISCOURAGED — prefer the password file below.
export FIXSIM_PASSWORD="{{ celnet_fixsim_password }}"
{% endif %}
# The secret is handed to the client through THIS environment only. The client rejects a
# --password flag outright: argv is world-readable, so a flag would publish the secret to
# every local account via `ps`.
# Host-local password file (mode 600, NOT in git) — the launcher reads it into FIXSIM_PASSWORD
# when present, so the ESP refdata gRPC login (AuthService.Login) uses the real service
# credential instead of the "password" fallback (which fails login and kills the ESP leg).
# Defaults to lp-sim's own pw file so a box that provisioned lp-sim needs no extra step.
export FIXSIM_PASSWORD_FILE="{{ celnet_fixsim_password_file | default('/home/' + (celnet_user | default('celnet')) + '/.fixsim_pw') }}"
PIDFILE="$FIXSIM_RUN_DIR/fix-sim.pid"

is_running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then echo "fix-sim already running (pid $(cat "$PIDFILE"))"; exit 0; fi
    [[ -x "$FIXSIM_RFQ_BIN" ]] || { echo "ERROR: $FIXSIM_RFQ_BIN missing (deploy a release with celnet_fixsim_enabled)"; exit 1; }
    FIXSIM_DAEMON=1 "$LAUNCHER"
    ;;
  once)
    FIXSIM_ONESHOT=1 "$LAUNCHER"
    ;;
  restart)
    # Managed-service restart: stop any running daemon, then start a fresh one. Used by
    # the deploy (deploy.yml post_tasks) so every release re-launches the FIX sim — the
    # launcher itself also sweeps stray sims, so this converges even if the PID file drifted.
    "$0" stop || true
    sleep 1
    "$0" start
    ;;
  stop)
    if is_running; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; echo "Stopped."; else echo "fix-sim not running"; rm -f "$PIDFILE"; fi
    ;;
  status)
    if is_running; then echo "fix-sim: RUNNING (pid $(cat "$PIDFILE"))"; echo "  log: $FIXSIM_LOG"; echo "  acceptor: $FIXSIM_HOST:${FIXSIM_PORT:-auto} (${FIXSIM_SENDER:-auto} -> ${FIXSIM_TARGET:-CELNET})"; else echo "fix-sim: STOPPED"; exit 3; fi
    ;;
  tail)
    tail -n "${2:-50}" -f "$FIXSIM_LOG"
    ;;
  *)
    echo "usage: fixsimctl {start|once|restart|stop|status|tail [n]}"; exit 64
    ;;
esac
