#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# simsctl — ONE control surface over every deployed celnet simulator.
# MANAGED BY ANSIBLE. Installed at {{ celnet_bin_dir }}/simsctl.
#
#   simsctl start | stop | restart | status | sweep
#
# The simulator fleet is a DEPLOY CONFIGURATION (`celnet_simulators_enabled` plus
# the per-simulator switches in group_vars), and this script is the one place that
# knows which legs that configuration turned on. Five inbound connections:
#
#   LP-SIM   — the NAMED over-the-counter counterparty panel (marketaccess-sim,
#              traderweb-sim, citigroup-sim, jpm-sim) streaming cash/swap/STIR
#              two-ways into the LpFeed gRPC ingest and accepting orders over FIX
#              (this is what the Administration → LP Panel reports on)
#   CME-SIM  — the simulated listed venue (`cme-sim`) quoting the Treasury futures
#              complex in whole contracts and accepting orders over FIX
#   RFQ leg  — a FIX client sending one-shot quote requests
#   RFS leg  — a FIX client subscribing to a streaming (request-for-stream) venue
#   ESP leg  — a FIX client driving the Market-Data streaming venue off refdata
#
# The last three are legs of `fixsimctl`; LP-SIM is `lpsimctl` and CME-SIM is
# `cmesimctl`. This script fans out to all three so an operator (and `celnetctl`)
# has a single verb for "the sims".
#
# ## Why `sweep` exists, and why stop always runs it
#
# Every simulator is a CLIENT of celnet-server holding a long-lived connection. A
# server that goes away does not reap them: the clients sit in reconnect loops, and
# a restart that does not stop them first accumulates a new generation on top of the
# old (16 leaked `lp-sim` processes were observed on the UAT box this way). Worse,
# a leaked sim still authenticates and still pushes quotes, so the LP Panel reports
# phantom providers that no longer correspond to anything the operator configured.
#
# A pidfile alone cannot fix this, because the leak's defining property is that the
# pidfile has already drifted from reality. `sweep` therefore matches on the process
# IMAGE for this service account — not on a recorded pid — so it converges no matter
# how the bookkeeping was lost. `stop` runs it unconditionally after the polite
# per-daemon stop, which is what makes "kill and restart on every server restart"
# actually hold rather than merely usually hold.
#
# Scoped to `-u $(id -u)`: it only ever touches THIS service account's processes,
# never another user's.
# ---------------------------------------------------------------------------
set -euo pipefail

BIN_DIR="{{ celnet_bin_dir }}"
LPSIMCTL="${BIN_DIR}/lpsimctl"
CMESIMCTL="${BIN_DIR}/cmesimctl"
FIXSIMCTL="${BIN_DIR}/fixsimctl"

# Which legs this deploy configured. Rendered from group_vars, so the box always
# reflects the repository rather than whatever was last typed on it.
SIMS_ENABLED="{{ '1' if celnet_simulators_enabled | default(true) else '0' }}"
LPSIM_ENABLED="{{ '1' if celnet_lpsim_enabled | default(true) else '0' }}"
CMESIM_ENABLED="{{ '1' if celnet_cmesim_enabled | default(true) else '0' }}"
FIXSIM_ENABLED="{{ '1' if celnet_fixsim_enabled | default(true) else '0' }}"

# Seconds to wait for the swept processes to actually disappear. Like the server's
# own stop, SIGKILL is asynchronous: returning before the reap is what lets the next
# `start` race a corpse that still holds its session.
REAP_WAIT={{ celnet_simulators_reap_wait_seconds | default(10) }}

# The process images a stray simulator can present. `start-*-sim.sh` is included
# because the launcher supervises its client in a `while` loop — killing only the
# client leaves the supervisor to immediately respawn it.
STRAY_PATTERN='lp[-_]sim|cme[-_]sim|fix[-_]rfq[-_]client|start-fix-sim\.sh|start-lp-sim\.sh|start-cme-sim\.sh'

log() { echo "[simsctl] $*"; }

# True when the fleet is switched off entirely for this environment.
sims_off() { [[ "$SIMS_ENABLED" != "1" ]]; }

# Any stray simulator process still alive for this account?
strays() {
  pgrep -u "$(id -u)" -f "$STRAY_PATTERN" 2>/dev/null || true
}

# Kill every simulator process for this account, however its bookkeeping drifted.
# SIGTERM first so a client can close its FIX session cleanly, then SIGKILL for
# anything that ignored it, then a bounded wait for the actual reap.
sweep() {
  local pids
  pids="$(strays)"
  if [[ -z "$pids" ]]; then
    log "sweep: no simulator processes running"
    return 0
  fi
  log "sweep: terminating $(echo "$pids" | wc -w | tr -d ' ') simulator process(es)"
  # shellcheck disable=SC2086
  kill -TERM $pids 2>/dev/null || true
  local waited=0
  while [[ -n "$(strays)" ]] && (( waited < REAP_WAIT )); do
    sleep 1
    waited=$(( waited + 1 ))
  done
  if [[ -n "$(strays)" ]]; then
    log "sweep: escalating to SIGKILL"
    pkill -9 -u "$(id -u)" -f "$STRAY_PATTERN" 2>/dev/null || true
    waited=0
    while [[ -n "$(strays)" ]] && (( waited < REAP_WAIT )); do
      sleep 1
      waited=$(( waited + 1 ))
    done
  fi
  if [[ -n "$(strays)" ]]; then
    log "WARNING: simulator process(es) still present after ${REAP_WAIT}s: $(strays | tr '\n' ' ')"
    return 1
  fi
  log "sweep: all simulator processes reaped"
}

start() {
  if sims_off; then
    log "simulators disabled for this environment (celnet_simulators_enabled=false); nothing to start"
    return 0
  fi
  local started=0
  if [[ "$LPSIM_ENABLED" == "1" && -x "$LPSIMCTL" ]]; then
    log "starting LP-SIM (liquidity providers → LpFeed ingest)"
    "$LPSIMCTL" start || log "WARNING: lpsimctl start failed"
    started=1
  fi
  if [[ "$CMESIM_ENABLED" == "1" && -x "$CMESIMCTL" ]]; then
    log "starting CME-SIM (listed Treasury-futures venue → LpFeed ingest + FIX orders)"
    "$CMESIMCTL" start || log "WARNING: cmesimctl start failed"
    started=1
  fi
  if [[ "$FIXSIM_ENABLED" == "1" && -x "$FIXSIMCTL" ]]; then
    log "starting FIX simulator (RFQ + RFS + ESP client legs)"
    "$FIXSIMCTL" start || log "WARNING: fixsimctl start failed"
    started=1
  fi
  (( started )) || log "no simulator is enabled; nothing to start"
}

stop() {
  # Politely first, so a client closes its FIX session rather than dropping it, then
  # sweep unconditionally — the polite path only covers daemons whose pidfile is still
  # accurate, and the whole point of this script is to also catch the ones where it is
  # not.
  [[ -x "$FIXSIMCTL" ]] && { "$FIXSIMCTL" stop || true; }
  [[ -x "$CMESIMCTL" ]] && { "$CMESIMCTL" stop || true; }
  [[ -x "$LPSIMCTL" ]] && { "$LPSIMCTL" stop || true; }
  sweep || true
}

status() {
  if sims_off; then echo "simulators: DISABLED (celnet_simulators_enabled=false)"; return 0; fi
  local rc=0
  if [[ "$LPSIM_ENABLED" == "1" && -x "$LPSIMCTL" ]]; then
    "$LPSIMCTL" status || rc=3
  else
    echo "lp-sim: NOT DEPLOYED"
  fi
  if [[ "$CMESIM_ENABLED" == "1" && -x "$CMESIMCTL" ]]; then
    "$CMESIMCTL" status || rc=3
  else
    echo "cme-sim: NOT DEPLOYED"
  fi
  if [[ "$FIXSIM_ENABLED" == "1" && -x "$FIXSIMCTL" ]]; then
    "$FIXSIMCTL" status || rc=3
  else
    echo "fix-sim: NOT DEPLOYED"
  fi
  local n; n="$(strays | wc -w | tr -d ' ')"
  echo "simulator processes for this account: ${n}"
  return $rc
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  sweep)   sweep ;;
  status)  status ;;
  *) echo "usage: simsctl {start|stop|restart|sweep|status}"; exit 64 ;;
esac
