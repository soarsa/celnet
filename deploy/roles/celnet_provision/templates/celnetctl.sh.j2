#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# celnetctl — start/stop/status control for celnet-server on this host.
# MANAGED BY ANSIBLE. Installed at {{ celnet_bin_dir }}/celnetctl.
#
#   celnetctl start | stop | restart | status | tail
#
# Runs the binary from the `current` release symlink, sources the shared env
# file, writes a pidfile, and logs to the shared log dir. Stop is graceful:
# celnet-server drains on SIGINT (see ARCHITECTURE.md §5), so we send SIGINT
# and wait before escalating to SIGKILL.
#
# RESTART IS RACE-SAFE. `restart` used to be `stop; start` back-to-back, which is a
# bug: SIGKILL is ASYNCHRONOUS, so `kill` returns long before the kernel has torn the
# process down and released its listening sockets. `start` then bound a port the corpse
# still held and died with `Os { code: 98, AddrInUse }`, leaving the server DOWN on a
# routine deploy. Three bounded waits close it — `stop` waits for the reap,
# `restart` waits for the ports, and `start` retries an in-use bind with backoff.
# ---------------------------------------------------------------------------
set -euo pipefail

BASE="{{ celnet_base }}"
CURRENT="{{ celnet_current_link }}"
BIN="${CURRENT}/bin/celnet-server"
ENV_FILE="{{ celnet_config_dir }}/celnet.env"
PIDFILE="{{ celnet_run_dir }}/celnet-server.pid"
LOG="{{ celnet_log_dir }}/celnet-server.out.log"
DRAIN_WAIT={{ celnet_stop_drain_seconds | default(35) }}
KILL_WAIT={{ celnet_kill_wait_seconds | default(10) }}
PORT_FREE_WAIT={{ celnet_port_free_wait_seconds | default(20) }}
START_ATTEMPTS={{ celnet_start_attempts | default(4) }}
START_SETTLE={{ celnet_start_settle_seconds | default(2) }}

# --- Simulator fleet coupling -------------------------------------------------
# Every simulator is a CLIENT of this server, so its lifecycle belongs to the
# server's. Left uncoupled, a restart orphans the previous generation: the clients
# survive in reconnect loops, a new generation is launched on top, and the leaked
# ones keep authenticating and pushing quotes — surfacing as phantom providers on
# the LP Panel that match nothing an operator configured.
#
# So: sims go DOWN before the server (they are its clients — dropping the server
# first would only make them thrash), and come back UP only once the server is
# confirmed listening. `simsctl stop` sweeps by process image, so this converges
# even when a pidfile has already drifted.
#
# Set celnet_simulators_restart_with_server=false to decouple them (an operator
# driving the sims by hand); absent simsctl (no simulator deployed) every hook
# below is a silent no-op, so a sim-free box behaves exactly as before.
SIMSCTL="{{ celnet_bin_dir }}/simsctl"
SIMS_COUPLED="{{ '1' if celnet_simulators_restart_with_server | default(true) else '0' }}"

# Run a simsctl verb, if the fleet is deployed AND coupled. Never fails the server
# operation: the server is the mission-critical process here, and a simulator that
# would not stop must not be the reason a restart aborts.
sims() {
  [[ "$SIMS_COUPLED" == "1" ]] || return 0
  [[ -x "$SIMSCTL" ]] || return 0
  "$SIMSCTL" "$1" || echo "WARNING: simsctl $1 reported a failure (continuing)"
}

# Source the shared env ONCE, exported, so EVERY subcommand sees the real bind
# addresses — the port probes and `status` included, not just the spawned child.
# (Previously only `start` sourced it, so `status` reported the build-time template
# default rather than what the server was actually configured to bind.)
if [[ -f "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  set -a; source "$ENV_FILE"; set +a
fi

is_running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid; pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# The TCP ports celnet-server listens on, taken from the env it will actually load.
# `host:port` → `port` via the RIGHTMOST colon, so IPv6 literals survive intact.
listen_ports() {
  local grpc ws
  grpc="${CELNET_GRPC_ADDR:-{{ celnet_grpc_addr }}}"
  ws="${CELNET_WS_ADDR:-{{ celnet_ws_addr }}}"
  echo "${grpc##*:}" "${ws##*:}"
}

# True when ANY listening port is still bound. `ss` absent ⇒ report free: we must not
# block a start on a probe we cannot run (the bind retry in `start` is the backstop).
port_bound() {
  command -v ss >/dev/null 2>&1 || return 1
  local p
  for p in $(listen_ports); do
    if ss -lnt 2>/dev/null | awk -v port=":${p}" '$4 ~ port"$" { found = 1 } END { exit !found }'; then
      return 0
    fi
  done
  return 1
}

# Wait (bounded) for every listening port to be released. Non-zero if still bound.
wait_ports_free() {
  local waited=0
  while (( waited < PORT_FREE_WAIT )); do
    port_bound || return 0
    sleep 1
    waited=$(( waited + 1 ))
  done
  ! port_bound
}

start() {
  if is_running; then
    echo "celnet-server already running (pid $(cat "$PIDFILE"))"; return 0
  fi
  [[ -x "$BIN" ]] || { echo "ERROR: $BIN not found/executable (deploy a release first)"; exit 1; }
  [[ -f "$ENV_FILE" ]] || { echo "ERROR: env file $ENV_FILE missing"; exit 1; }
  echo "Starting celnet-server from $(readlink -f "$CURRENT")"
  local attempt=1 backoff=2 pid mark
  while true; do
    # Where the log ends BEFORE this attempt, so the in-use check below reads only
    # THIS attempt's output — never a stale AddrInUse from an earlier failed start.
    # Guard on existence: the `< "$LOG"` redirection is performed by the SHELL, so on a
    # first-ever start its failure would print to the script's stderr and slip past a
    # `2>/dev/null` attached to `wc`.
    mark=0
    if [[ -f "$LOG" ]]; then mark=$(wc -l < "$LOG"); fi
    nohup "$BIN" >>"$LOG" 2>&1 &
    pid=$!
    echo "$pid" > "$PIDFILE"
    sleep "$START_SETTLE"
    if is_running; then
      echo "Started (pid $pid). Logs: $LOG"
      # Sims come up only now — they authenticate against this server, so starting
      # them before it is listening just burns their reconnect backoff.
      sims start
      return 0
    fi
    # Retry ONLY the address-in-use race. Every other startup failure is a real defect
    # and must surface at once rather than be masked behind a retry loop.
    if (( attempt < START_ATTEMPTS )) \
       && tail -n +"$(( mark + 1 ))" "$LOG" 2>/dev/null | grep -q "AddrInUse"; then
      echo "Bind refused (address still in use); retrying in ${backoff}s [attempt $(( attempt + 1 ))/${START_ATTEMPTS}]..."
      sleep "$backoff"
      backoff=$(( backoff * 2 ))
      attempt=$(( attempt + 1 ))
      continue
    fi
    # Never leave a pidfile pointing at a process that is not running — a stale one
    # makes the next `stop` a no-op and misleads every operator who reads it.
    rm -f "$PIDFILE"
    echo "ERROR: celnet-server failed to start; last log lines:"; tail -n 20 "$LOG" || true
    exit 1
  done
}

stop() {
  # Sims first, unconditionally — even when the server is already down, since that
  # is exactly the state in which orphans accumulate.
  sims stop
  if ! is_running; then echo "celnet-server not running"; rm -f "$PIDFILE"; return 0; fi
  local pid; pid="$(cat "$PIDFILE")"
  echo "Stopping celnet-server (pid $pid), draining up to ${DRAIN_WAIT}s..."
  kill -INT "$pid" 2>/dev/null || true
  for _ in $(seq 1 "$DRAIN_WAIT"); do
    is_running || { echo "Stopped."; rm -f "$PIDFILE"; return 0; }
    sleep 1
  done
  echo "Drain timed out; sending SIGKILL."
  kill -KILL "$pid" 2>/dev/null || true
  # SIGKILL is ASYNCHRONOUS. `kill` returns immediately, but the kernel still has to
  # tear the process down and release its listening sockets — and a drain that just
  # timed out implies plenty of connections left to unwind. Returning here is exactly
  # what let `restart` bind a port the corpse still held. Wait for the actual reap.
  local waited=0
  while kill -0 "$pid" 2>/dev/null && (( waited < KILL_WAIT )); do
    sleep 1
    waited=$(( waited + 1 ))
  done
  rm -f "$PIDFILE"
  if kill -0 "$pid" 2>/dev/null; then
    echo "WARNING: pid $pid still present ${KILL_WAIT}s after SIGKILL (uninterruptible or zombie)."
  else
    echo "Killed (reaped after ${waited}s)."
  fi
}

status() {
  if is_running; then
    echo "celnet-server: RUNNING (pid $(cat "$PIDFILE"))"
    echo "  release: $(readlink -f "$CURRENT" 2>/dev/null || echo '?')"
    echo "  grpc:    ${CELNET_GRPC_ADDR:-{{ celnet_grpc_addr }}}   ws: ${CELNET_WS_ADDR:-{{ celnet_ws_addr }}}"
  else
    echo "celnet-server: STOPPED"; return 3
  fi
}

# The server's status plus the simulator fleet's — one command for "what is up".
status_all() {
  local rc=0
  status || rc=$?
  if [[ -x "$SIMSCTL" ]]; then
    echo
    "$SIMSCTL" status || true
  fi
  return $rc
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart)
    stop || true
    # Never hand `start` a port the previous process has not yet released. If the wait
    # expires we still proceed — `start`'s bind retry is the second line of defence —
    # but say so, because a port bound this long is someone else's process, not ours.
    if ! wait_ports_free; then
      echo "WARNING: listening port(s) still bound after ${PORT_FREE_WAIT}s; start will retry the bind."
    fi
    start
    ;;
  status)  status_all ;;
  tail)    tail -n "${2:-50}" -f "$LOG" ;;
  # Drive the simulator fleet without touching the server (the escape hatch for an
  # operator who wants the sims bounced on their own).
  sims)    [[ -x "$SIMSCTL" ]] || { echo "no simulator deployed on this host"; exit 3; }
           "$SIMSCTL" "${2:-status}" ;;
  *) echo "usage: celnetctl {start|stop|restart|status|tail [n]|sims [start|stop|restart|sweep|status]}"; exit 64 ;;
esac
