<?xml version="1.0" encoding="UTF-8"?>
<!--
  celnet FX-options FIX 4.4 data dictionary (QuickFIX format).

  This is the machine-readable contract for the celnet inbound FIX acceptor: the
  exact MsgTypes, fields, and required/optional sets the engine validates against.
  It is the QuickFIX projection of the engine's own dialect dictionary
  (crates/celnet-fix/src/dictionary.rs) and message builders
  (crates/celnet-fix/src/messages.rs, dialect_fx.rs) — one contract, no drift.

  Drop it into any QuickFIX-family engine (quickfix, quickfix-go, quickfixn,
  quickfix/j) as the session DataDictionary to build a price-taking client that
  speaks RFQ -> Quote -> NewOrderSingle -> ExecutionReport against a celnet
  acceptor. The companion guide (celnet-fix-api.md) explains the message flow,
  the CompID rules, and the convention checks the engine enforces beyond this
  dictionary.

  Required flags mirror the engine's `required_tags`: only the dictionary-level
  required tags are marked Y. The instrument block on a single-leg QuoteRequest
  (Symbol/SecurityType/PutOrCall/StrikePrice/StrikeCurrency/ExerciseStyle +
  ExpiryYears) and the leg group on a multileg request are additionally enforced
  by the dialect mapper with specific errors — see the guide.

  Custom dialect tags (FIX tolerates user-defined tags >= 5000):
    7001 ExpiryYears  - the option's exact vol-time in years (RFQ instrument)
    7011 BidPxExact   - the bid premium to full f64 precision (Quote provenance)
    7012 OfferPxExact - the offer premium to full f64 precision (Quote provenance)
    7013 LastPxExact  - the fill premium to full f64 precision (ExecReport provenance)
-->
<fix type="FIX" major="4" minor="4" servicepack="0">

  <header>
    <field name="BeginString" required="Y"/>
    <field name="BodyLength" required="Y"/>
    <field name="MsgType" required="Y"/>
    <field name="SenderCompID" required="Y"/>
    <field name="TargetCompID" required="Y"/>
    <field name="MsgSeqNum" required="Y"/>
    <field name="SendingTime" required="Y"/>
    <field name="PossDupFlag" required="N"/>
    <field name="OrigSendingTime" required="N"/>
  </header>

  <trailer>
    <field name="CheckSum" required="Y"/>
  </trailer>

  <messages>
    <!-- ===================== session / admin ===================== -->
    <message name="Heartbeat" msgtype="0" msgcat="admin">
      <field name="TestReqID" required="N"/>
    </message>
    <message name="TestRequest" msgtype="1" msgcat="admin">
      <field name="TestReqID" required="Y"/>
    </message>
    <message name="ResendRequest" msgtype="2" msgcat="admin">
      <field name="BeginSeqNo" required="Y"/>
      <field name="EndSeqNo" required="Y"/>
    </message>
    <message name="Reject" msgtype="3" msgcat="admin">
      <field name="RefSeqNum" required="Y"/>
      <field name="RefMsgType" required="N"/>
      <field name="Text" required="N"/>
    </message>
    <message name="SequenceReset" msgtype="4" msgcat="admin">
      <field name="NewSeqNo" required="Y"/>
      <field name="GapFillFlag" required="N"/>
    </message>
    <message name="Logout" msgtype="5" msgcat="admin">
      <field name="Text" required="N"/>
    </message>
    <message name="Logon" msgtype="A" msgcat="admin">
      <field name="EncryptMethod" required="Y"/>
      <field name="HeartBtInt" required="Y"/>
      <field name="ResetSeqNumFlag" required="N"/>
    </message>

    <!-- ===================== application ===================== -->
    <!--
      QuoteRequest (R): single-leg RFQ carries the flat instrument block;
      a strategy RFQ carries the NoLegs(555) repeating group instead.
    -->
    <message name="QuoteRequest" msgtype="R" msgcat="app">
      <field name="QuoteReqID" required="Y"/>
      <field name="Symbol" required="N"/>
      <field name="Product" required="N"/>
      <field name="SecurityType" required="N"/>
      <field name="PutOrCall" required="N"/>
      <field name="StrikePrice" required="N"/>
      <field name="StrikeCurrency" required="N"/>
      <field name="ExerciseStyle" required="N"/>
      <field name="MaturityDate" required="N"/>
      <field name="ExpiryYears" required="N"/>
      <group name="NoLegs" required="N">
        <field name="LegSymbol" required="N"/>
        <field name="LegSecurityType" required="N"/>
        <field name="LegStrikePrice" required="N"/>
        <field name="LegPutOrCall" required="N"/>
        <field name="LegSide" required="N"/>
        <field name="LegRatioQty" required="N"/>
        <field name="LegCurrency" required="N"/>
        <field name="LegMaturityDate" required="N"/>
      </group>
    </message>

    <!-- Quote (S): the venue's two-way response to an RFQ. -->
    <message name="Quote" msgtype="S" msgcat="app">
      <field name="QuoteReqID" required="N"/>
      <field name="QuoteID" required="Y"/>
      <field name="Symbol" required="N"/>
      <field name="BidPx" required="N"/>
      <field name="OfferPx" required="N"/>
      <field name="BidSize" required="N"/>
      <field name="OfferSize" required="N"/>
      <field name="ValidUntilTime" required="N"/>
      <field name="BidPxExact" required="N"/>
      <field name="OfferPxExact" required="N"/>
    </message>

    <message name="MassQuote" msgtype="i" msgcat="app">
      <field name="QuoteID" required="Y"/>
    </message>

    <message name="QuoteCancel" msgtype="Z" msgcat="app">
      <field name="QuoteID" required="Y"/>
    </message>

    <!-- NewOrderSingle (D): lift a quoted price by QuoteID + Side. -->
    <message name="NewOrderSingle" msgtype="D" msgcat="app">
      <field name="ClOrdID" required="Y"/>
      <field name="QuoteID" required="N"/>
      <field name="Symbol" required="N"/>
      <field name="Side" required="Y"/>
      <field name="OrderQty" required="Y"/>
      <field name="OrdType" required="N"/>
      <field name="TransactTime" required="N"/>
    </message>

    <message name="NewOrderMultileg" msgtype="AB" msgcat="app">
      <field name="ClOrdID" required="Y"/>
      <field name="Side" required="N"/>
      <field name="TransactTime" required="N"/>
      <group name="NoLegs" required="Y">
        <field name="LegSymbol" required="N"/>
        <field name="LegSecurityType" required="N"/>
        <field name="LegStrikePrice" required="N"/>
        <field name="LegPutOrCall" required="N"/>
        <field name="LegSide" required="N"/>
        <field name="LegRatioQty" required="N"/>
      </group>
    </message>

    <!-- ExecutionReport (8): fill (ExecType=F) or rejection (ExecType=8). -->
    <message name="ExecutionReport" msgtype="8" msgcat="app">
      <field name="OrderID" required="Y"/>
      <field name="ExecID" required="Y"/>
      <field name="ClOrdID" required="N"/>
      <field name="ExecType" required="Y"/>
      <field name="OrdStatus" required="Y"/>
      <field name="Symbol" required="N"/>
      <field name="Side" required="N"/>
      <field name="LastQty" required="N"/>
      <field name="LastPx" required="N"/>
      <field name="LastPxExact" required="N"/>
      <field name="MultiLegReportingType" required="N"/>
      <field name="Text" required="N"/>
    </message>
  </messages>

  <fields>
    <!-- session / header / trailer -->
    <field number="8" name="BeginString" type="STRING"/>
    <field number="9" name="BodyLength" type="LENGTH"/>
    <field number="10" name="CheckSum" type="STRING"/>
    <field number="34" name="MsgSeqNum" type="SEQNUM"/>
    <field number="35" name="MsgType" type="STRING"/>
    <field number="43" name="PossDupFlag" type="BOOLEAN"/>
    <field number="49" name="SenderCompID" type="STRING"/>
    <field number="52" name="SendingTime" type="UTCTIMESTAMP"/>
    <field number="56" name="TargetCompID" type="STRING"/>
    <field number="122" name="OrigSendingTime" type="UTCTIMESTAMP"/>

    <!-- session admin bodies -->
    <field number="7" name="BeginSeqNo" type="SEQNUM"/>
    <field number="16" name="EndSeqNo" type="SEQNUM"/>
    <field number="36" name="NewSeqNo" type="SEQNUM"/>
    <field number="45" name="RefSeqNum" type="SEQNUM"/>
    <field number="58" name="Text" type="STRING"/>
    <field number="98" name="EncryptMethod" type="INT">
      <value enum="0" description="NONE_OTHER"/>
    </field>
    <field number="108" name="HeartBtInt" type="INT"/>
    <field number="112" name="TestReqID" type="STRING"/>
    <field number="123" name="GapFillFlag" type="BOOLEAN"/>
    <field number="141" name="ResetSeqNumFlag" type="BOOLEAN"/>
    <field number="372" name="RefMsgType" type="STRING"/>

    <!-- instrument block -->
    <field number="15" name="Currency" type="CURRENCY"/>
    <field number="55" name="Symbol" type="STRING"/>
    <field number="64" name="SettlDate" type="LOCALMKTDATE"/>
    <field number="120" name="SettlCurrency" type="CURRENCY"/>
    <field number="167" name="SecurityType" type="STRING">
      <value enum="FXVO" description="FX_VANILLA_OPTION"/>
      <value enum="FXNO" description="FX_NON_DELIVERABLE_OPTION"/>
    </field>
    <field number="201" name="PutOrCall" type="INT">
      <value enum="0" description="PUT"/>
      <value enum="1" description="CALL"/>
    </field>
    <field number="202" name="StrikePrice" type="PRICE"/>
    <field number="460" name="Product" type="INT">
      <value enum="4" description="CURRENCY"/>
    </field>
    <field number="461" name="CFICode" type="STRING"/>
    <field number="541" name="MaturityDate" type="LOCALMKTDATE"/>
    <field number="947" name="StrikeCurrency" type="CURRENCY"/>
    <field number="1079" name="MaturityTime" type="STRING"/>
    <field number="1194" name="ExerciseStyle" type="INT">
      <value enum="0" description="EUROPEAN"/>
      <value enum="1" description="AMERICAN"/>
    </field>

    <!-- quote / pricing -->
    <field number="38" name="OrderQty" type="QTY"/>
    <field number="62" name="ValidUntilTime" type="UTCTIMESTAMP"/>
    <field number="117" name="QuoteID" type="STRING"/>
    <field number="131" name="QuoteReqID" type="STRING"/>
    <field number="132" name="BidPx" type="PRICE"/>
    <field number="133" name="OfferPx" type="PRICE"/>
    <field number="134" name="BidSize" type="QTY"/>
    <field number="135" name="OfferSize" type="QTY"/>
    <field number="152" name="CashOrderQty" type="QTY"/>
    <field number="423" name="PriceType" type="INT"/>
    <field number="537" name="QuoteType" type="INT">
      <value enum="0" description="INDICATIVE"/>
      <value enum="1" description="TRADEABLE"/>
    </field>
    <field number="693" name="QuoteRespID" type="STRING"/>

    <!-- order / exec -->
    <field number="11" name="ClOrdID" type="STRING"/>
    <field number="17" name="ExecID" type="STRING"/>
    <field number="31" name="LastPx" type="PRICE"/>
    <field number="32" name="LastQty" type="QTY"/>
    <field number="37" name="OrderID" type="STRING"/>
    <field number="39" name="OrdStatus" type="CHAR">
      <value enum="F" description="FILLED"/>
      <value enum="8" description="REJECTED"/>
    </field>
    <field number="40" name="OrdType" type="CHAR">
      <value enum="D" description="PREVIOUSLY_QUOTED"/>
    </field>
    <field number="44" name="Price" type="PRICE"/>
    <field number="54" name="Side" type="CHAR">
      <value enum="1" description="BUY"/>
      <value enum="2" description="SELL"/>
    </field>
    <field number="60" name="TransactTime" type="UTCTIMESTAMP"/>
    <field number="150" name="ExecType" type="CHAR">
      <value enum="F" description="TRADE"/>
      <value enum="8" description="REJECTED"/>
    </field>
    <field number="442" name="MultiLegReportingType" type="INT">
      <value enum="1" description="SINGLE_SECURITY"/>
      <value enum="3" description="MULTILEG_SECURITY"/>
    </field>

    <!-- multileg group -->
    <field number="555" name="NoLegs" type="NUMINGROUP"/>
    <field number="556" name="LegCurrency" type="CURRENCY"/>
    <field number="600" name="LegSymbol" type="STRING"/>
    <field number="608" name="LegCFICode" type="STRING"/>
    <field number="609" name="LegSecurityType" type="STRING"/>
    <field number="611" name="LegMaturityDate" type="LOCALMKTDATE"/>
    <field number="612" name="LegStrikePrice" type="PRICE"/>
    <field number="623" name="LegRatioQty" type="FLOAT"/>
    <field number="624" name="LegSide" type="CHAR">
      <value enum="1" description="BUY"/>
      <value enum="2" description="SELL"/>
    </field>
    <field number="654" name="LegRefID" type="STRING"/>
    <field number="1358" name="LegPutOrCall" type="INT">
      <value enum="0" description="PUT"/>
      <value enum="1" description="CALL"/>
    </field>

    <!-- custom dialect provenance tags (user-defined, >= 5000) -->
    <field number="7001" name="ExpiryYears" type="FLOAT"/>
    <field number="7011" name="BidPxExact" type="FLOAT"/>
    <field number="7012" name="OfferPxExact" type="FLOAT"/>
    <field number="7013" name="LastPxExact" type="FLOAT"/>
  </fields>

</fix>
