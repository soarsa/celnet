# lodestar.judge.toml — host-side judge + execute-verify driver config (EXAMPLE)
#
# This file configures the OPTIONAL, DEFAULT-OFF host-side drivers that sit
# BEHIND the engine's existing seams. The lodestar engine itself reads NONE of
# this: it stays pure-C, model-free, network-free, air-gapped. These drivers are
# what a *user* runs; they read this config (or the matching env vars), call the
# engine's `knowledge_review` drive path for the rubric+evidence, run the model
# or sandbox OUTSIDE the engine, and hand the engine back only a verdict.
#
# Precedence (highest first):  environment variable  >  this file  >  built-in default.
# Every key has an env-var twin (shown in the comment) so CI can override without
# a file. Copy this to `lodestar.judge.toml` next to your repo or set
# LODESTAR_JUDGE_CONFIG=/path/to/lodestar.judge.toml.
#
# Nothing here turns a model on by default: provider="none" is the floor and is
# what an unconfigured machine resolves to.

[engine]
# Path to the lodestar binary the drivers shell out to (the engine seam).
# env: LODESTAR_BIN   default: "lodestar" on PATH (Windows: lodestar.exe)
bin = "lodestar"
# Project key the drivers operate on (matches index_repository / knowledge_*).
# env: LODESTAR_PROJECT
project = "github.com-soarsa-celnet"

[judge]
# Which Stage-2 judge tier to use. One of:
#   none     T0 — deterministic Stage-1 gate only; no model is ever consulted (default).
#   claude   T1 — isolated Claude subagent (same-family, context-isolated).
#   ollama   T2 — on-demand local cross-family model via Ollama (recommended).
#   api      T3 — external API family (key-gated, breaks air-gap).
# env: LODESTAR_JUDGE_PROVIDER   default: "none"
provider = "none"

# Resolved model TIER hint when the machine's resources aren't auto-detected, or
# to pin a tier. "auto" lets the driver size from detected RAM/VRAM.
#   auto | small | medium | large
# env: LODESTAR_JUDGE_TIER   default: "auto"
tier = "auto"

[judge.ollama]
# env: OLLAMA_HOST   default: "http://127.0.0.1:11434"
host = "http://127.0.0.1:11434"
# Short keep-alive so the judge model unloads right after the verdict and does
# not linger in RAM/VRAM between reviews. env: OLLAMA_KEEP_ALIVE
keep_alive = "30s"
# Per-tier model ids (different family than Claude). Leave blank to use the
# driver's built-in tier table. These are resolved by detected headroom unless
# `tier` above is pinned.
#   small  ~2.5-3.5 GB  16 GB laptop / shared memory
#   medium ~larger      32 GB unified or >=8 GB VRAM
#   large               ample VRAM
# env: LODESTAR_OLLAMA_MODEL_SMALL / _MEDIUM / _LARGE
model_small  = "gemma3:4b"      # or phi4-mini, qwen3:4b
model_medium = "qwen3:8b"       # or gemma3:12b
model_large  = "gemma3:12b"
# Hard cap on the verdict generation (bounded review). env: LODESTAR_JUDGE_TIMEOUT_S
timeout_s = 120

[judge.api]
# T3 only. Key is read from the env var named here; the key value is NEVER
# stored in this file. If the env var is empty the api driver degrades to a
# clear "no key" message and records nothing.
# env: LODESTAR_API_KEY_ENV  (name of the var holding the key)
key_env = "ANTHROPIC_API_KEY"      # or OPENAI_API_KEY, GEMINI_API_KEY, ...
# A DIFFERENT family than the claim author. The driver refuses to run if this
# would self-judge (the engine seam also rejects it). env: LODESTAR_API_MODEL
model = "gpt-5"
# env: LODESTAR_API_BASE_URL
base_url = "https://api.openai.com/v1"
timeout_s = 120

[execute_verify]
# Optional execute-to-verify backend for the kinds where running adds signal
# (primarily invariant:pure by effect-denial). The deterministic static gate is
# ALWAYS the primary; this only ever adds a second signal AFTER static admission.
#   off        no execution; static verdict stands (default).
#   wasmtime   portable software sandbox (effect-denial). Linux/Windows/macOS.
#   hyperlight micro-VM (Linux/Windows only; macOS deferred).
# env: LODESTAR_EXECUTE_BACKEND   default: "off"
backend = "off"
# env: LODESTAR_WASMTIME_BIN   default: "wasmtime" on PATH
wasmtime_bin = "wasmtime"
# env: LODESTAR_HYPERLIGHT_BIN
hyperlight_bin = "hyperlight-run"
# Wall-clock cap for any single execution (a runaway repo function). seconds.
# env: LODESTAR_EXECUTE_TIMEOUT_S
timeout_s = 10
