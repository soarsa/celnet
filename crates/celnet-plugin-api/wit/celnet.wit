// Celnet user-extensibility SDK — WIT contract (runtime-agnostic).
//
// This `world` is the structural mirror of the Rust trait contract in `src/`
// (PricingModel / SmileModel / Calibration). It is a SPEC/DOC artifact: the
// records/enums here map one-to-one to the Rust types and are FROZEN. The
// contract is deliberately runtime-agnostic — only the *host runtime* choice has
// changed (see docs/PLUGIN-HOST-ALT.md / ADR).
//
// Host runtime: `celnet-plugin-host` runs the Tier-2 untrusted sandbox on
// **wasmi** (the pure-Rust, fuel-metered interpreter — NOT wasmtime, which
// carries open 2026 RustSec advisories). wasmi hosts **core Wasm modules**, not
// the Component Model (wasmi's Component Model is WIP), so the host lowers these
// records onto a host-controlled core-module `(ptr,len)` ABI rather than
// component-model bindings. The shapes below are unchanged either way; if/when
// wasmi ships an advisory-clean Component Model we can lift this world directly.
//
// Design rules (see docs/ARCHITECTURE.md §6.3):
//   * Single, current contract — NO version negotiation, NO schema_version.
//   * Records/enums map ONE-TO-ONE to the Rust types so first-party native
//     models and Wasm user plugins are interchangeable behind one registry.
//   * Flat POD shapes only (no experimental WIT `map`/`struct`/resource
//     features): calibration targets cross as a `list<calibration-target>`,
//     which lowers cleanly onto the core-module ABI.
//   * `f64` is the CPU-canonical scalar (the Rust contract's policy). The host
//     pins float behaviour (NaN canonicalization at every boundary value, libm
//     transcendentals, no FMA contraction) so output is bit-identical across
//     platforms — the determinism the replay harness asserts.

package celnet:plugin-api;

// ---------------------------------------------------------------------------
// Shared vocabulary — mirrors `celnet-types` DTOs / enums.
// ---------------------------------------------------------------------------
interface types {
    // OptionType (celnet_types::OptionType).
    enum option-type {
        call,
        put,
    }

    // Underlying asset class (celnet_types::Underlying). The asset-class
    // discriminator; the FX arm carries no extra payload here (the currency-pair
    // identity does not enter the carry/forward math — it travels out-of-band).
    // Further asset classes are added by their wave as additive cases.
    variant underlying {
        // An FX currency pair.
        fx,
    }

    // Cost-of-carry model (celnet_types::Carry). FX carries two rates; other
    // asset classes carry a single discount rate `r` and net carry `b`. Both
    // reduce to forward `F = S·e^{b·t}` and discount `e^{−r·t}`; for FX,
    // `r = r-dom` and `b = r-dom − r-for`.
    variant carry {
        // FX two-rate carry: domestic (quote) `r-dom`, foreign (base) `r-for`.
        fx-rates(tuple<f64, f64>),
        // Generalized cost-of-carry: discount rate `r`, net carry `b`.
        cost-of-carry(tuple<f64, f64>),
    }

    // CarryInputs (celnet_core::CarryInputs). The generalized, carry-tagged
    // pricing input. `t` is a vol-time year fraction; `vol` is absolute
    // (0.10 = 10 vol); rates are continuously-compounded.
    record carry-inputs {
        spot: f64,
        strike: f64,
        vol: f64,
        t: f64,
        underlying: underlying,
        carry: carry,
    }

    // Carry-tagged rate sensitivities (celnet_types::RateSensitivities). FX
    // reports the two rate rhos; other asset classes report a discount-rho
    // `∂V/∂r` and a carry-rho `∂V/∂b`.
    variant rate-sensitivities {
        // FX: (rho-dom = ∂V/∂r-dom, rho-for = ∂V/∂r-for).
        fx(tuple<f64, f64>),
        // Generalized: (discount-rho = ∂V/∂r, carry-rho = ∂V/∂b).
        carry(tuple<f64, f64>),
    }

    // CarryGreeks (celnet_core::CarryGreeks) — the generalized sensitivity strip,
    // raw units. The carry-neutral block mirrors the FX Greek set; the rate block
    // is carry-tagged.
    record carry-greeks {
        price: f64,
        delta-spot: f64,
        delta-forward: f64,
        gamma: f64,
        vega: f64,
        theta: f64,
        rates: rate-sensitivities,
        vanna: f64,
        volga: f64,
        charm: f64,
        speed: f64,
        zomma: f64,
        color: f64,
    }
}

// ---------------------------------------------------------------------------
// Portable error + descriptor — mirror `PluginError` / `ModelDescriptor`.
// ---------------------------------------------------------------------------
interface diagnostics {
    // PluginError (crate::PluginError). The detail string is provenance-neutral
    // and carries no user data, matching the `&'static str` payloads natively.
    variant plugin-error {
        invalid-input(string),
        unsupported(string),
        did-not-converge(string),
        calibration-failed(string),
        not-found(string),
    }

    // ModelKind (crate::ModelKind).
    enum model-kind {
        pricing,
        smile,
        calibration,
    }

    // GreekSupport (crate::GreekSupport).
    record greek-support {
        first-order: bool,
        second-order: bool,
        third-order: bool,
    }

    // ModelDescriptor (crate::ModelDescriptor). `id` is the purpose-named
    // ModelId string.
    record model-descriptor {
        id: string,
        kind: model-kind,
        greeks: greek-support,
    }
}

// ---------------------------------------------------------------------------
// Calibration vocabulary — mirrors `CalibrationTarget` / `CalibrationReport`.
// ---------------------------------------------------------------------------
interface calibration-types {
    // CalibrationTarget (crate::CalibrationTarget).
    record calibration-target {
        abscissa: f64,
        observed: f64,
        weight: f64,
    }

    // CalibrationReport (crate::CalibrationReport).
    record calibration-report {
        iterations: u32,
        rms-residual: f64,
        max-residual: f64,
    }

    // The flat scalar parameters a calibrator produces. A concrete user model
    // exports its own parameter record; the reference flat-vol model fits a
    // single volatility, expressed here as the canonical result shape.
    record calibrated-params {
        // Fitted parameters, in the model's own order (e.g. `[flat-vol]`).
        params: list<f64>,
        report: calibration-report,
    }
}

// ---------------------------------------------------------------------------
// The three model seams a component may export. A plugin component exports
// `describe` plus whichever of the three interfaces it implements; the host
// admits it to the matching registry slot by its declared `model-kind`.
// ---------------------------------------------------------------------------

// PricingModel (crate::PricingModel). Generalized over the carry-tagged
// vocabulary, so a guest may price any asset class (FX or cost-of-carry), not
// only FX.
interface pricing-model {
    use types.{option-type, carry-inputs, carry-greeks};
    use diagnostics.{plugin-error};

    // Present value in the numeraire currency, per 1 unit of base notional.
    price: func(opt: option-type, inputs: carry-inputs) -> result<f64, plugin-error>;

    // Price plus the full carry-tagged Greek strip in one pass (Unsupported if
    // not provided).
    price-and-greeks: func(opt: option-type, inputs: carry-inputs)
        -> result<carry-greeks, plugin-error>;
}

// SmileModel (crate::SmileModel : celnet_core::Smile).
interface smile-model {
    use diagnostics.{plugin-error};

    // Implied (Black) volatility at `strike` given `forward` and time `t`.
    implied-vol: func(strike: f64, forward: f64, t: f64) -> result<f64, plugin-error>;

    // ATM-forward volatility convenience (strike == forward).
    atm-forward-vol: func(forward: f64, t: f64) -> result<f64, plugin-error>;

    // Static (butterfly) no-arbitrage self-check over a strike grid.
    check-no-arbitrage: func(forward: f64, t: f64, strikes: list<f64>)
        -> result<_, plugin-error>;
}

// Calibration (crate::Calibration).
interface calibration {
    use calibration-types.{calibration-target, calibrated-params};
    use diagnostics.{plugin-error};

    // Fit model parameters to weighted targets at `forward` / time `t`.
    calibrate: func(forward: f64, t: f64, targets: list<calibration-target>)
        -> result<calibrated-params, plugin-error>;
}

// ---------------------------------------------------------------------------
// Worlds. A plugin targets `celnet-plugin`; it MUST export `describe` and at
// least one model interface. The reference flat-vol plugin exports all three.
// ---------------------------------------------------------------------------
world celnet-plugin {
    use diagnostics.{model-descriptor};

    // Self-description used by the host registry to route work by purpose
    // without knowing the component's concrete model type.
    export describe: func() -> model-descriptor;

    export pricing-model;
    export smile-model;
    export calibration;
}
