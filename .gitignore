# Rust
/target
**/target
**/*.rs.bk
*.pdb

# sccache / build caches
.sccache/

# Coverage
*.profraw
*.profdata
/coverage
lcov.info

# cargo-mutants output (regenerable mutation-testing artifact)
/mutants.out
/mutants.out.old

# Criterion benchmark output
/target/criterion

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local env overrides
.env
.env.local

# lodestar graph cache is machine-local and regenerable; it lives in ~/.cache/lodestar/,
# not in the repo tree. The .lodestar/ knowledge dir IS committed (see rules below).

# GUI incremental TS build info (regenerable)
gui/**/*.tsbuildinfo

# Workflow worktree-isolation checkouts (transient)
.claude/worktrees/

# Transient Playwright-MCP browser-debug console logs (not source)
.playwright-mcp/
docs/celnet-capabilities.standalone.html
docs/_capabilities-build/
node_modules/

# Resumable gate-runner step journal (machine-local, per-worktree; MUST stay ignored
# so ledger appends never perturb the tree fingerprint — see tools/gate-runner.sh)
.gate-ledger.jsonl

# Managed inbound FIX-acceptor persisted store (runtime artifact; path from CELNET_FIX_CONFIG)
fix-connections.json
fix-connections.json.tmp

# Operator identity store — users + desks + Argon2id password hashes (runtime
# artifact; path from CELNET_IDENTITY_CONFIG). Never commit credentials.
identity.json
identity.json.tmp

# >>> lodestar init >>>
.lodestar/*
!.lodestar/knowledge/
!.lodestar/knowledge/events/
!.lodestar/knowledge/events/**
!.lodestar/knowledge/snapshot.json
.lodestar/**/*.db
.lodestar/**/graph.db.zst
.lodestar/sync/key
.lodestar/sync/sign_key
!.lodestar/project-id
!.mcp.json
# <<< lodestar init <<<

# lodestar knowledge: the SHARED SOURCE OF TRUTH is the anchor-carrying MIRROR
# (.lodestar/knowledge/claims-mirror.json + CLAIMS.md + DELIVERABLES.md), NOT the raw event
# log. lodestar's event log carries no anchors, so it cannot rehydrate the live projection on
# a fresh clone or after a projection loss (lodestar#18) — it + the snapshot are machine-local,
# regenerable, per-machine-HLC caches (churn, not shared truth). tools/lodestar/sync-knowledge.sh
# rebuilds the live projection from the mirror on SessionStart (background, staleness-guarded).
# These overrides win over the lodestar-init un-ignore above (a later rule wins) + survive re-init.
.lodestar/knowledge/snapshot.json
.lodestar/knowledge/events/
.lodestar/index.log
.lodestar/knowledge-sync.log

# Office (Excel/Word) temp lock files
~$*
