/target
**/target
**/*.rs.bk
*.pdb

# sccache / build caches
.sccache/

# Coverage
*.profraw
*.profdata
/coverage
lcov.info

# cargo-mutants output (regenerable mutation-testing artifact)
/mutants.out
/mutants.out.old

# Criterion benchmark output
/target/criterion

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local env overrides
.env
.env.local

# codebase-memory-mcp local index artifact (machine-local, regenerable, not synced)
.codebase-memory/

# GUI incremental TS build info (regenerable)
gui/**/*.tsbuildinfo

# Workflow worktree-isolation checkouts (transient)
.claude/worktrees/

# Transient Playwright-MCP browser-debug console logs (not source)
.playwright-mcp/
docs/celnet-capabilities.standalone.html
docs/_capabilities-build/
node_modules/

# Resumable gate-runner step journal (machine-local, per-worktree; MUST stay ignored
# so ledger appends never perturb the tree fingerprint — see tools/gate-runner.sh)
.gate-ledger.jsonl

# Managed inbound FIX-acceptor persisted store (runtime artifact; path from CELNET_FIX_CONFIG)
fix-connections.json
fix-connections.json.tmp

# Operator identity store — users + desks + Argon2id password hashes (runtime
# artifact; path from CELNET_IDENTITY_CONFIG). Never commit credentials.
identity.json
identity.json.tmp

# >>> lodestar init >>>
.lodestar/*
!.lodestar/knowledge/
!.lodestar/knowledge/events/
!.lodestar/knowledge/events/**
!.lodestar/knowledge/snapshot.json
.lodestar/**/*.db
.lodestar/**/graph.db.zst
.lodestar/sync/key
.lodestar/sync/sign_key
!.lodestar/project-id
!.mcp.json
# <<< lodestar init <<<

# lodestar knowledge SNAPSHOT = machine-local. It is a single mutable freshness record
# (a real merge hotspot across many developers) and is fully regenerable by folding the
# content-addressed event log. Only events/ (immutable, hash-named => pure set-union, ZERO
# textual conflict) + project-id are the shared source of truth. This overrides the
# lodestar-init un-ignore above (a later .gitignore rule wins), and survives a re-init.
.lodestar/knowledge/snapshot.json

# Office (Excel/Word) temp lock files
~$*
