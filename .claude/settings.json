{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(source \"$HOME/.cargo/env\":*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(rustfmt:*)",
      "Bash(just:*)",
      "Bash(cargo-nextest:*)",
      "Bash(cargo-deny:*)",
      "Bash(cargo-audit:*)",
      "Bash(cargo-llvm-cov:*)",
      "Bash(cargo-mutants:*)",
      "Bash(cargo-machete:*)",
      "Bash(sccache:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote add origin:*)"
    ],
    "ask": []
  },
  "env": {
    "RUSTC_WRAPPER": "sccache",
    "CARGO_TERM_COLOR": "always"
  }
}
